# ──────────────────────────────────────────────
# BADE PAPA OS — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file.

# ── Supabase (pre-configured, do not change) ──
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI Provider (optional) ─────────────────────
# If not set, the app uses a built-in local AI engine.
# Supported providers: openai, gemini, groq, openrouter
# VITE_AI_PROVIDER=openai

# ── AI Model (optional, provider-specific) ─────
# Examples: gpt-4o-mini, gemini-1.5-flash, llama-3.3-70b-versatile
# VITE_AI_MODEL=gpt-4o-mini

# Note: AI API keys are stored securely server-side (Supabase Edge Function secrets).
# They are NEVER exposed in frontend code.
# The following are set as Supabase Edge Function secrets (not in .env):
#   AI_PROVIDER  — same provider name as above
#   AI_API_KEY   — your provider API key
#   AI_MODEL     — model name
